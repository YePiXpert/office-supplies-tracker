# API 服务端构建 + 运行
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY pnpm-workspace.yaml package.json ./
COPY pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
RUN pnpm install --frozen-lockfile --filter @procure-lite/server... --filter @procure-lite/shared
COPY packages/shared packages/shared
COPY apps/server apps/server
RUN pnpm --filter @procure-lite/shared build \
  && cd apps/server && npx prisma generate \
  && pnpm --filter @procure-lite/server build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages/shared/package.json ./packages/shared/
COPY --from=build /repo/packages/shared/dist ./packages/shared/dist
COPY --from=build /repo/apps/server/package.json ./apps/server/
COPY --from=build /repo/apps/server/dist ./apps/server/dist
COPY --from=build /repo/apps/server/prisma ./apps/server/prisma
COPY --from=build /repo/apps/server/node_modules ./apps/server/node_modules
WORKDIR /app/apps/server
EXPOSE 3000
# 运行时建表：migrate deploy（有迁移）或 db push（兜底）；exec 让 SIGTERM 直达 node 实现优雅停机
CMD ["sh", "-c", "export DATABASE_URL=\"\${DATABASE_URL:-file:\${DATA_DIR:-/app/state}/procure.db}\"; npx prisma migrate deploy || npx prisma db push --skip-generate; exec node dist/main.js"]
